@page "/"

<PageTitle>Nick Soan | Software Engineer</PageTitle>

<section class="hero">
    <div class="container">
        <div class="hero-grid">
            <div>
                <p class="eyebrow">Software Engineer • .NET • Cloud</p>
                <h1>Nick Soan</h1>
                <p class="lead">
                    I build reliable digital products with modern .NET engineering, clear communication, and a strong focus
                    on delivering practical outcomes for users and teams.
                </p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="https://www.linkedin.com/in/nicksoan/" target="_blank" rel="noopener noreferrer">View LinkedIn profile</a>
                    <a class="btn btn-outline" href="#experience">View experience</a>
                </div>
            </div>
            <div class="hero-photo-wrap">
                <img class="profile-photo" src="images/profile.png" alt="Nick Soan profile picture" />
            </div>
        </div>
    </div>
</section>

<section id="about" class="section container">
    <h2>About</h2>
    <p>
        I’m a software engineer who enjoys turning business ideas into maintainable, production-ready software.
        My work emphasizes scalable architecture, thoughtful implementation, and consistent delivery across the
        full development lifecycle.
    </p>
</section>

<section id="experience" class="section container">
    <h2>What I bring</h2>
    <ul class="highlights">
        <li>Hands-on expertise with C#, .NET, Blazor, and cloud-first delivery practices.</li>
        <li>Experience delivering end-to-end features from discovery through deployment.</li>
        <li>Strong emphasis on code quality, user impact, and long-term maintainability.</li>
    </ul>
</section>

<section id="skills" class="section container">
    <h2>Core skills</h2>
    <div class="skills-grid">
        <span>.NET</span>
        <span>Blazor</span>
        <span>C#</span>
        <span>Azure</span>
        <span>REST APIs</span>
        <span>SQL</span>
        <span>Git</span>
        <span>CI/CD</span>
    </div>
</section>

<section id="contact" class="section container contact">
    <h2>Contact</h2>
    <p>I’m open to opportunities and conversations about impactful engineering work.</p>
    <div class="contact-links">
        <a href="https://www.linkedin.com/in/nicksoan/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/nicksoan" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
</section>
